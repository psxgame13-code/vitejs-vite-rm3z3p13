# Frontend (públicas). No painel da Netlify, crie com o mesmo nome.
# Supabase → Project Settings → API → Project URL e anon public key.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon

# Só no servidor (Netlify Functions). NUNCA use o prefixo VITE_.
# NUNCA coloque a service_role no frontend nem neste arquivo versionado com valor real.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_apenas_na_Netlify